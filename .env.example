# Copie este arquivo para .env e substitua todos os valores de exemplo.
# Nunca versione o arquivo .env nem use estas credenciais em produção.

# Execução local (SQLite)
DATABASE_URL=sqlite:///./encurtador.db
BASE_URL=http://localhost:8000
DEFAULT_EXPIRATION_DAYS=7

# Docker Compose (PostgreSQL)
# O Compose monta DATABASE_URL automaticamente a partir destas variáveis.
POSTGRES_USER=encurtador_user
POSTGRES_PASSWORD=substitua-por-uma-senha-forte
POSTGRES_DB=encurtador_db
